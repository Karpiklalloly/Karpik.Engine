<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockTheme="clr-namespace:Dock.Avalonia.Themes.Fluent;assembly=Dock.Avalonia.Themes.Fluent"
             x:Class="Karpik.Editor.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <dockTheme:DockFluentTheme />
    <StyleInclude Source="avares://Karpik.Editor/Styles/EditorTheme.axaml" />
  </Application.Styles>
</Application>
