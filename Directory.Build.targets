<?xml version="1.0" encoding="utf-8"?>
<Project>
    <Import Project="$(MSBuildThisFileDirectory)Generated\KarpikModuleCatalog.props"
            Condition="Exists('$(MSBuildThisFileDirectory)Generated\KarpikModuleCatalog.props')" />

    <Target Name="KarpikResolveCodegenDependencies" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <_KarpikCodegenAnalyzer Include="@(Analyzer)"
                                   Condition="$([System.String]::Copy('%(Analyzer.MSBuildSourceProjectFile)').EndsWith('.Codegen.csproj'))" />
            <!-- Roslyn must receive dependency paths even when DLLs sit next to the generator. -->
            <Analyzer Include="%(_KarpikCodegenAnalyzer.RootDir)%(_KarpikCodegenAnalyzer.Directory)*.dll"
                      Condition="'@(_KarpikCodegenAnalyzer)' != ''"
                      Exclude="@(Analyzer)" />
        </ItemGroup>
    </Target>

    <!-- The extension submodule still references the former root-level core project. -->
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'DragonECS.Karpik.Extensions'">
        <ProjectReference Remove="..\..\Karpik.Engine.Core\Karpik.Engine.Core.csproj" />
        <ProjectReference Include="$(KarpikRepositoryRoot)src\Karpik.Engine.Core\Karpik.Engine.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <_KarpikCompileModuleDependency Include="@(KarpikModuleDependency)" />
        <_KarpikCompileModuleDependency Remove="@(KarpikModuleDependency->WithMetadataValue('Optional', 'true'))" />
        <_KarpikCompileModuleDependency Include="@(KarpikModuleDependency->WithMetadataValue('Optional', 'true')->WithMetadataValue('ResolvedModuleSelected', 'true'))" />
        <ProjectReference Include="@(_KarpikCompileModuleDependency->'%(ResolvedProjectPath)')"
                          Visible="true" />
    </ItemGroup>

    <Target Name="KarpikValidateResolvedModuleDependencies"
            BeforeTargets="PrepareForBuild">
        <Error Condition="'%(KarpikModuleDependency.Identity)' != '' AND '%(KarpikModuleDependency.ResolvedProjectPath)' == ''"
               Text="$(MSBuildProjectFullPath): unknown KarpikModuleDependency id '%(KarpikModuleDependency.Identity)'." />
    </Target>

    <ItemGroup>
        <PackageReference Update="Newtonsoft.Json" Version="$(KarpikNewtonsoftJsonVersion)"
                          Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
        <PackageReference Include="Newtonsoft.Json"
                          Condition="'$(MSBuildProjectName)' == 'Veldrid' OR '$(MSBuildProjectName)' == 'Veldrid.SDL2' OR '$(MSBuildProjectName)' == 'Veldrid.RenderDoc'">
            <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(KarpikNewtonsoftJsonVersion)</Version>
        </PackageReference>
    </ItemGroup>

    <Target Name="KarpikValidateProjectGraph"
            BeforeTargets="Build"
            Condition="
              '$(KarpikSkipValidation)' != 'true'
              AND (
                '$(MSBuildProjectName)' == 'Karpik.Engine.Client.Publish'
                OR '$(MSBuildProjectName)' == 'Karpik.Engine.Server.Publish'
              )">
        <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)src/Configurator/Configurator.csproj&quot; -- --validate"
              WorkingDirectory="$(MSBuildThisFileDirectory)" />
    </Target>
</Project>
