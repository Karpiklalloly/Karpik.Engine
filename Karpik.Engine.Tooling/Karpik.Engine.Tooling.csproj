<Project Sdk="Microsoft.NET.Sdk">
  <!-- Настраивает библиотеку общих инструментов SDK и packager. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Убирает несвязанные генераторы из графа инструментальной библиотеки. -->
  <ItemGroup>
    <ProjectReference Remove="$(KarpikRepositoryRoot)Network.Codegen\Network.Codegen\Network.Codegen.csproj;$(KarpikRepositoryRoot)StatAndAbilities.Codegen\StatAndAbilities.Codegen\StatAndAbilities.Codegen.csproj" />
  </ItemGroup>
</Project>
