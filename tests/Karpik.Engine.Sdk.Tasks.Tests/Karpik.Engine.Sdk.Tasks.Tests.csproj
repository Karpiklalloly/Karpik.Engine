<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Framework" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Karpik.Engine.Sdk.Tasks\Karpik.Engine.Sdk.Tasks.csproj" />
        <ProjectReference Include="..\..\src\Karpik.Engine.Core\Karpik.Engine.Core.csproj" />
        <ProjectReference Include="..\..\src\Karpik.Engine.Tooling\Karpik.Engine.Tooling.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\src\Karpik.Engine.Sdk\Sdk\Sdk.targets"
              Link="Sdk.targets"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\src\Karpik.Engine.Sdk\Sdk\Sdk.props"
              Link="Sdk.props"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\src\Karpik.Engine.Sdk\Sdk\Solution.targets"
              Link="Solution.targets"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\src\Karpik.Engine.Sdk\Templates\Directory.Solution.targets"
              Link="Directory.Solution.targets"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\src\Karpik.Engine.Sdk\Karpik.Engine.Sdk.csproj"
              Link="Karpik.Engine.Sdk.csproj"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Remove="$(KarpikRepositoryRoot)src\Network.Codegen\Network.Codegen\Network.Codegen.csproj;$(KarpikRepositoryRoot)src\StatAndAbilities.Codegen\StatAndAbilities.Codegen\StatAndAbilities.Codegen.csproj" />
    </ItemGroup>

</Project>
