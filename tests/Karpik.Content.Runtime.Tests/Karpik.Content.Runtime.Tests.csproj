<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Karpik.Content.Core\Karpik.Content.Core.csproj" />
    <ProjectReference Include="..\..\src\Karpik.Content.Runtime\Karpik.Content.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Karpik.Engine.Core\Karpik.Engine.Core.csproj" />
    <ProjectReference Include="..\..\src\Karpik.Content.Runtime.Codegen\Karpik.Content.Runtime.Codegen.csproj" />
    <ProjectReference Include="../Karpik.Content.BindingFixture/Karpik.Content.BindingFixture.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="_BindingFixtureAssembly" />
  </ItemGroup>
  <Target Name="CopyBindingCollectibleFixture" AfterTargets="Build">
    <Copy SourceFiles="@(_BindingFixtureAssembly)" DestinationFolder="$(TargetDir)BindingFixture" />
  </Target>
</Project>
