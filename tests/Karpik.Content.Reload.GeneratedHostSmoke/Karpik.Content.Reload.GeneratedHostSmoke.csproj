<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <KarpikSide>Client</KarpikSide>
    <KarpikProjectKind>Tool</KarpikProjectKind>
    <KarpikCompositionMode>Static</KarpikCompositionMode>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="KarpikSide" />
    <CompilerVisibleProperty Include="KarpikProjectKind" />
    <CompilerVisibleProperty Include="KarpikCompositionMode" />
    <ProjectReference Include="../../src/Karpik.Engine.Core.Runner/Karpik.Engine.Core.Runner.csproj" />
    <ProjectReference Include="../../src/Karpik.Engine.Core.Codegen/Karpik.Engine.Core.Codegen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
