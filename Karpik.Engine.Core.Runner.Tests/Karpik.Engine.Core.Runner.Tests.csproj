<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <AssemblyName>Karpik.Engine.Core.Runner.Tests</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" />
      <PackageReference Include="xunit" />
      <PackageReference Include="xunit.runner.visualstudio">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\first-parties\DragonECS.Karpik.Extensions\DragonECS.Karpik.Extensions.csproj" />
      <ProjectReference Include="..\Karpik.Engine.Core\Karpik.Engine.Core.csproj" />
      <ProjectReference Include="..\Karpik.Engine.Core.Runner\Karpik.Engine.Core.Runner.csproj" />
      <ProjectReference Include="..\Karpik.Content.Runtime\Karpik.Content.Runtime.csproj" />
      <ProjectReference Include="..\Karpik.Engine.Tooling\Karpik.Engine.Tooling.csproj" />
      <ProjectReference Include="..\Karpik.Engine.Core.Runner.TestWorker\Karpik.Engine.Core.Runner.TestWorker.csproj" />
      <ProjectReference Include="..\Modules\Client\Graphics\Graphics.Core\Graphics.Core.csproj" />
      <ProjectReference Include="..\Modules\Shared\AssetManagement\AssetManagement.Core\AssetManagement.Core.csproj" />
      <ProjectReference Include="..\Modules\Shared\ECS\ECS.Core\ECS.Core.csproj" />
      <ProjectReference Include="..\Karpik.Engine.Core.Generator\Karpik.Engine.Core.Codegen\Karpik.Engine.Core.Codegen.csproj"
                        OutputItemType="Analyzer"
                        ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="NativeAotSmoke\**\*.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(CI)' == 'true'">
      <None Include="..\.github\runner-tests.xunit.json"
            TargetPath="xunit.runner.json"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\Karpik.Engine.Core.Runner\StaticComposition\**\*.cs"
            LinkBase="StaticCompositionSources"
            CopyToOutputDirectory="PreserveNewest" />
      <None Include="..\Modules\Shared\ECS\ECS.Core\AssetManagement\Converters\**\*.cs"
            LinkBase="EcsCoreSources"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
