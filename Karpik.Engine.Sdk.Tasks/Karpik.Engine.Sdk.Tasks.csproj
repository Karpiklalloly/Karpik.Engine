<Project Sdk="Microsoft.NET.Sdk">

    <!-- Настраивает сборку MSBuild-задач SDK. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Подключает API MSBuild только для компиляции задач, не поставляя их вместе с результатом. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <!-- Подключает модель проектов и tooling, используемые задачами SDK. -->
    <ItemGroup>
        <ProjectReference Include="..\Karpik.Engine.ProjectModel\Karpik.Engine.ProjectModel.csproj" />
        <ProjectReference Include="..\Karpik.Engine.Tooling\Karpik.Engine.Tooling.csproj" />
    </ItemGroup>

    <!-- Убирает генераторы, которые не должны стать частью графа задач SDK. -->
    <ItemGroup>
        <ProjectReference Remove="$(KarpikRepositoryRoot)Network.Codegen\Network.Codegen\Network.Codegen.csproj;$(KarpikRepositoryRoot)StatAndAbilities.Codegen\StatAndAbilities.Codegen\StatAndAbilities.Codegen.csproj" />
    </ItemGroup>

</Project>
