<Project Sdk="Microsoft.NET.Sdk">

    <!-- Описывает NuGet-пакет SDK и пути к артефактам, которые будут упакованы. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <PackageId>Karpik.Engine.Sdk</PackageId>
        <PackageVersion Condition="'$(PackageVersion)' == ''">0.6.0-local</PackageVersion>
        <Authors>KarpikEngine</Authors>
        <Description>MSBuild SDK for validated external KarpikEngine game projects.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <KarpikSdkTasksOutputPath Condition="'$(KarpikSdkTasksOutputPath)' == ''">..\Karpik.Engine.Sdk.Tasks\bin\$(Configuration)\net10.0\</KarpikSdkTasksOutputPath>
        <KarpikContentToolOutputPath Condition="'$(KarpikContentToolOutputPath)' == ''">..\Karpik.Content.Tool\bin\$(Configuration)\net10.0\</KarpikContentToolOutputPath>
        <KarpikContentRuntimeOutputPath Condition="'$(KarpikContentRuntimeOutputPath)' == ''">..\Karpik.Content.Runtime\bin\$(Configuration)\net10.0\</KarpikContentRuntimeOutputPath>
    </PropertyGroup>

    <!-- Payload нужен только пакету SDK; обычный build не должен проходить весь этот граф. -->
    <ItemGroup>
        <KarpikSdkPayloadProject Include="..\Karpik.Engine.Sdk.Tasks\Karpik.Engine.Sdk.Tasks.csproj" />
        <KarpikSdkPayloadProject Include="..\Karpik.Content.Tool\Karpik.Content.Tool.csproj" />
        <KarpikSdkPayloadProject Include="..\Karpik.Content.Runtime\Karpik.Content.Runtime.csproj" />
    </ItemGroup>

    <!-- Включает targets, шаблон и готовые DLL в layout NuGet-пакета SDK. -->
    <ItemGroup>
        <None Include="Sdk\Sdk.props" Pack="true" PackagePath="Sdk/" />
        <None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk/" />
        <None Include="Sdk\Solution.targets" Pack="true" PackagePath="Sdk/" />
        <None Include="Templates\Directory.Solution.targets" Pack="true" PackagePath="templates/" />
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="$(KarpikSdkTasksOutputPath)Karpik.Engine.Sdk.Tasks.dll"
              Pack="true"
              PackagePath="tools/net10.0/" />
        <None Include="$(KarpikSdkTasksOutputPath)Karpik.Engine.ProjectModel.dll"
              Pack="true"
              PackagePath="tools/net10.0/" />
        <None Include="$(KarpikSdkTasksOutputPath)Karpik.Engine.Tooling.dll"
              Pack="true"
              PackagePath="tools/net10.0/" />
        <None Include="$(KarpikContentRuntimeOutputPath)Karpik.Content.Runtime.dll"
              Pack="true"
              PackagePath="tools/net10.0/content/" />
    </ItemGroup>

    <Target Name="PrepareKarpikSdkPackage" BeforeTargets="_GetPackageFiles" Condition="'$(NoBuild)' != 'true'">
        <MSBuild Projects="@(KarpikSdkPayloadProject);@(KarpikCodegenProject)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)" />
    </Target>

    <Target Name="_KarpikPackageContentPayload" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <None Include="$(KarpikContentToolOutputPath)**\*"
                  Pack="true"
                  PackagePath="tools/net10.0/content/" />
        </ItemGroup>
    </Target>

    <Target Name="_KarpikPackageCodegenPayload" BeforeTargets="_GetPackageFiles" DependsOnTargets="PrepareKarpikSdkPackage">
        <MSBuild Projects="@(KarpikCodegenProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_KarpikCodegenOutput" />
        </MSBuild>
        <ItemGroup>
            <_KarpikCodegenFile Include="%(_KarpikCodegenOutput.RootDir)%(_KarpikCodegenOutput.Directory)*.dll">
                <GeneratorId>$([System.IO.Path]::GetFileNameWithoutExtension('%(_KarpikCodegenOutput.MSBuildSourceProjectFile)'))</GeneratorId>
            </_KarpikCodegenFile>
            <None Include="@(_KarpikCodegenFile)" Pack="true" PackagePath="codegen/%(_KarpikCodegenFile.GeneratorId)/" />
            <None Include="$(KarpikRepositoryRoot)Generated/KarpikCodegenCatalog.json" Pack="true" PackagePath="codegen/catalog.json" />
        </ItemGroup>
    </Target>

</Project>
