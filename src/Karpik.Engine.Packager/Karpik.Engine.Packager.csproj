<Project Sdk="Microsoft.NET.Sdk">
  <!-- Настраивает консольный packager engine payload. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Подключает общие проверки установки и публикации payload. -->
  <ItemGroup>
    <ProjectReference Include="..\Configurator\Configurator.csproj" />
    <ProjectReference Include="..\Karpik.Engine.Tooling\Karpik.Engine.Tooling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Remove="$(KarpikRepositoryRoot)Modules\Shared\Network.Shared\Network.Shared.Core.Codegen\Network.Shared.Core.Codegen.csproj;$(KarpikRepositoryRoot)Modules\Shared\StatAndAbilities.Codegen\StatAndAbilities.Codegen.csproj" />
  </ItemGroup>
</Project>
