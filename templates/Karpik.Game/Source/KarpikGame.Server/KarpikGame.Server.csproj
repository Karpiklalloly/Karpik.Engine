<Project Sdk="Karpik.Engine.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <KarpikProjectKind>Runtime</KarpikProjectKind>
    <KarpikSide>Server</KarpikSide>
    <KarpikContentEnabled>true</KarpikContentEnabled>
    <KarpikContentNamespace>game</KarpikContentNamespace>
    <KarpikContentSourceRoot>$(MSBuildProjectDirectory)\..\..\Content</KarpikContentSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KarpikGame.Shared\KarpikGame.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Content\runtime.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Content\**\*" CopyToOutputDirectory="PreserveNewest" Link="Content\%(RecursiveDir)%(Filename)%(Extension)" TargetPath="Content\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\Mods\**\*" CopyToOutputDirectory="PreserveNewest" Link="Mods\%(RecursiveDir)%(Filename)%(Extension)" TargetPath="Mods\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
