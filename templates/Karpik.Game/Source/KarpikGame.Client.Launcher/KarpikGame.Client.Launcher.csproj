<Project Sdk="Karpik.Engine.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <KarpikProjectKind>Tool</KarpikProjectKind>
    <KarpikSide>Client</KarpikSide>
    <!-- The Dynamic and Static entry points each carry top-level statements;
         only one of them may be part of the compilation. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Narrow Static+AOT suppression list (see docs/02_ADR/static-runtime-composition.md).
         IL2104/IL3053: aggregate from third-party payload assemblies
         (Aether.Physics2D, MoonSharp.Interpreter, Newtonsoft.Json, DragonECS,
         ImGui.NET) that ship without trim/AOT annotations; the first-party
         Static path is reflection-free and pinned by source-boundary tests.
         IL3000/IL3002: Silk.NET DefaultPathResolver probes native dependency
         paths via Assembly.Location, which is empty under AOT/single-file;
         native dependencies are staged next to the executable so resolution
         succeeds regardless - justified empirically by the runtime gate.
         Any OTHER IL2xxx/IL3xxx/IL3050 code must stay unsuppressed and fails
         the publish. -->
    <NoWarn Condition="'$(KarpikCompositionMode)' == 'Static' And '$(PublishAot)' == 'true'">$(NoWarn);IL2104;IL3053;IL3000;IL3002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs"
             Condition="'$(KarpikCompositionMode)' != 'Static'" />
    <Compile Include="..\KarpikGame.Launcher\EngineLauncher.cs" Link="EngineLauncher.cs"
             Condition="'$(KarpikCompositionMode)' != 'Static'" />
    <Compile Include="StaticEntry.cs"
             Condition="'$(KarpikCompositionMode)' == 'Static'" />
    <ProjectReference Include="..\KarpikGame.Client\KarpikGame.Client.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
    <ProjectReference Include="..\KarpikGame.Shared\KarpikGame.Shared.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- Static composition turns the launcher into the game-specific host executable:
       the whole side graph is compiled in and copied next to the host so the
       generated host can reach every installer and service. In Dynamic mode the
       references stay build-only and the external runner path is used unchanged. -->
  <Target Name="_KarpikEnableStaticRuntimeReference"
          BeforeTargets="AssignProjectConfiguration"
          Condition="'$(KarpikCompositionMode)' == 'Static'">
    <ItemGroup>
      <ProjectReference>
        <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
        <Private>true</Private>
      </ProjectReference>
    </ItemGroup>
  </Target>
</Project>
