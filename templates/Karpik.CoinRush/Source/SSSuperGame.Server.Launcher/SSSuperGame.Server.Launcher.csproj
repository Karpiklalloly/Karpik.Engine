<Project Sdk="Karpik.Engine.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <KarpikProjectKind>Tool</KarpikProjectKind>
    <KarpikSide>Server</KarpikSide>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs"
             Condition="'$(KarpikCompositionMode)' != 'Static'" />
    <Compile Include="..\SSSuperGame.Launcher\EngineLauncher.cs" Link="EngineLauncher.cs"
             Condition="'$(KarpikCompositionMode)' != 'Static'" />
    <Compile Include="StaticEntry.cs"
             Condition="'$(KarpikCompositionMode)' == 'Static'" />
    <ProjectReference Include="..\SSSuperGame.Server\SSSuperGame.Server.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
    <ProjectReference Include="..\SSSuperGame.Shared\SSSuperGame.Shared.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <Target Name="_KarpikStageStaticCookedContent"
          BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(KarpikCompositionMode)' == 'Static'">
    <!-- The referenced runtime cooks Content during its build. Enumerate it
         here so a clean launcher build includes the newly created artifacts. -->
    <ItemGroup>
      <ContentWithTargetPath Include="../SSSuperGame.Server/bin/$(Configuration)/$(TargetFramework)/Content/manifest.json"
                             TargetPath="Content/manifest.json"
                             CopyToOutputDirectory="PreserveNewest"
                             CopyToPublishDirectory="PreserveNewest" />
      <_KarpikStaticCookedArtifact Include="../SSSuperGame.Server/bin/$(Configuration)/$(TargetFramework)/Content/artifacts/**/*" />
      <ContentWithTargetPath Include="@(_KarpikStaticCookedArtifact)"
                             TargetPath="Content/artifacts/%(_KarpikStaticCookedArtifact.RecursiveDir)%(_KarpikStaticCookedArtifact.Filename)%(_KarpikStaticCookedArtifact.Extension)"
                             CopyToOutputDirectory="PreserveNewest"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="_KarpikEnableStaticRuntimeReference"
          BeforeTargets="AssignProjectConfiguration"
          Condition="'$(KarpikCompositionMode)' == 'Static'">
    <ItemGroup>
      <ProjectReference>
        <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
        <Private>true</Private>
      </ProjectReference>
    </ItemGroup>
  </Target>
</Project>
