<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Karpik.Launcher.CreateProjectWindow" Width="520" Height="360" Title="Создать проект">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="SDK" /><ComboBox x:Name="SdkBox" SelectionChanged="SdkChanged" />
    <TextBlock Text="Шаблон" /><ComboBox x:Name="TemplateBox" />
    <TextBlock Text="Имя проекта" /><TextBox x:Name="NameBox" Text="NewKarpikGame" />
    <TextBlock Text="Родительский каталог" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="DirectoryBox" /><Button Grid.Column="1" Content="Обзор..." Click="Browse" /></Grid>
    <CheckBox x:Name="OpenBox" Content="Открыть после создания" />
    <TextBlock x:Name="Status" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Отмена" Click="Cancel" /><Button Content="Создать" Click="Create" /></StackPanel>
  </StackPanel>
</Window>
