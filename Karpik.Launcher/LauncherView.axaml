<reactiveUi:ReactiveObject xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:viewModels="clr-namespace:Karpik.Launcher.ViewModels"
                xmlns:reactiveUi="clr-namespace:ReactiveUI;assembly=ReactiveUI"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="Karpik.Launcher.LauncherView"
                x:DataType="viewModels:ILauncherViewModel"
                x:Name="Root"
                d:DataContext="{d:DesignInstance Type=viewModels:ILauncherViewModel}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="KarpikEngine" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Choose a game. The launcher will select its exact engine and editor version."
                     Opacity="0.7"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Создать..." Click="CreateProject_OnClick" IsEnabled="{Binding !IsBusy}" />
          <Button Content="{Binding Localization[Select_Project]}" Command="{Binding OpenProjectCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="#20242C" CornerRadius="8" Padding="12">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock Text="{Binding Localization[Recent_Projects]}" FontWeight="SemiBold" />
          <ListBox x:Name="RecentProjectsList"
                   Grid.Row="1"
                   ItemsSource="{Binding RecentProjects}"
                   DoubleTapped="RecentProjects_OnDoubleTapped"
                   IsEnabled="{Binding !IsBusy}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="6" ColumnSpacing="16">
                  <StackPanel>
                    <TextBlock Text="{Binding SolutionPath}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LastOpenedUtc}" FontSize="11" Opacity="0.55" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="{Binding ViewModel.Localization[Open_Project], ElementName=Root}"
                          Command="{Binding ElementName=Root, Path=ViewModel.OpenRecentProjectCommand}"
                          CommandParameter="{Binding SolutionPath}" />
                  <Button Grid.Column="2" Content="Удалить" Click="RemoveProject_OnClick" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap">
          <TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Скопировать" Command="{Binding CopyErrorCommand}" />
            </ContextMenu>
          </TextBlock.ContextMenu>
        </TextBlock>
        <ProgressBar Grid.Column="1"
                     Width="120"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}" />
    </Grid>
  </Grid>
</reactiveUi:ReactiveObject>
