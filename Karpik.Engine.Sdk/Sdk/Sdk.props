<Project>
  <PropertyGroup>
    <KarpikRuntimeBundleDirectoryName>karpik-bundle</KarpikRuntimeBundleDirectoryName>
    <!-- Default composition mode since Milestone 8 (docs/02_ADR/static-runtime-composition.md).
         Empty normalizes to Static; explicit KarpikCompositionMode=Dynamic remains the
         supported rollback opt-in for one release cycle. -->
    <KarpikCompositionMode Condition="'$(KarpikCompositionMode)' == ''">Static</KarpikCompositionMode>
    <KarpikEnableNativeAotValidation Condition="'$(KarpikEnableNativeAotValidation)' == ''">false</KarpikEnableNativeAotValidation>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="KarpikSide" />
    <CompilerVisibleProperty Include="KarpikProjectKind" />
    <CompilerVisibleProperty Include="KarpikCompositionMode" />
  </ItemGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <KarpikContentNamespace Condition="'$(KarpikContentNamespace)' == '' and '$(KarpikContentEnabled)' == 'true'">game</KarpikContentNamespace>
    <KarpikContentSourceRoot Condition="'$(KarpikContentSourceRoot)' == ''">$(MSBuildProjectDirectory)\Content</KarpikContentSourceRoot>
    <KarpikContentOutput>$(IntermediateOutputPath)Content\</KarpikContentOutput>
    <KarpikContentManifest>$(KarpikContentOutput)manifest.json</KarpikContentManifest>
    <KarpikContentToolDll Condition="'$(KarpikContentToolDll)' == ''">$(MSBuildThisFileDirectory)..\..\Karpik.Content.Tool\bin\$(Configuration)\net10.0\content.dll</KarpikContentToolDll>
  </PropertyGroup>
  <!-- Content codegen is opt-in: enabled only when KarpikContentEnabled=true or KarpikContentNamespace is set, and Content folder exists -->
  <ItemGroup Condition="'$(KarpikContentEnabled)' == 'true' or '$(KarpikContentNamespace)' != ''">
    <ProjectReference Include="$(KarpikRepositoryRoot)Karpik.Content.Codegen/Karpik.Content.Codegen.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <AdditionalFiles Include="**\*.json.meta" />
    <CompilerVisibleProperty Include="KarpikContentManifest" />
    <CompilerVisibleProperty Include="KarpikContentNamespace" />
    <CompilerVisibleProperty Include="KarpikContentSourceRoot" />
  </ItemGroup>
  <Target Name="KarpikContentToolBuild" Condition="('$(KarpikContentEnabled)' == 'true' or '$(KarpikContentNamespace)' != '') and Exists('$(KarpikContentSourceRoot)') and !Exists('$(KarpikContentToolDll)')">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\Karpik.Content.Tool\Karpik.Content.Tool.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>
  <Target Name="KarpikContentBuild" BeforeTargets="BeforeCompile" DependsOnTargets="KarpikContentToolBuild" Condition="('$(KarpikContentEnabled)' == 'true' or '$(KarpikContentNamespace)' != '') and Exists('$(KarpikContentSourceRoot)') and Exists('$(KarpikContentToolDll)')">
    <Exec Command="dotnet &quot;$(KarpikContentToolDll)&quot; build --source &quot;$(KarpikContentSourceRoot)&quot; --output &quot;$(KarpikContentOutput)&quot; --namespace $(KarpikContentNamespace)" />
  </Target>
</Project>
