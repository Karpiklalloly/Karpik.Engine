<Project>
  <PropertyGroup>
    <KarpikRuntimeBundleDirectoryName>karpik-bundle</KarpikRuntimeBundleDirectoryName>
    <!-- Default composition mode since Milestone 8 (docs/02_ADR/static-runtime-composition.md).
         Empty normalizes to Static; explicit KarpikCompositionMode=Dynamic remains the
         supported rollback opt-in for one release cycle. -->
    <KarpikCompositionMode Condition="'$(KarpikCompositionMode)' == ''">Static</KarpikCompositionMode>
    <KarpikEnableNativeAotValidation Condition="'$(KarpikEnableNativeAotValidation)' == ''">false</KarpikEnableNativeAotValidation>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="KarpikSide" />
    <CompilerVisibleProperty Include="KarpikProjectKind" />
    <CompilerVisibleProperty Include="KarpikCompositionMode" />
  </ItemGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <KarpikContentOutput>$(IntermediateOutputPath)Content\</KarpikContentOutput>
    <KarpikContentManifest>$(KarpikContentOutput)manifest.json</KarpikContentManifest>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="**\*.json.meta" />
    <CompilerVisibleProperty Include="KarpikContentManifest" />
  </ItemGroup>
  <Target Name="KarpikContentBuild" BeforeTargets="BeforeCompile" Condition="Exists('$(KarpikRepositoryRoot)Karpik.Content.Tool/Karpik.Content.Tool.csproj')">
    <Exec Command="dotnet &quot;$(KarpikRepositoryRoot)Karpik.Content.Tool/bin/$(Configuration)/net10.0/content.dll&quot; build --source &quot;$(MSBuildProjectDirectory)/Content&quot; --output &quot;$(KarpikContentOutput)&quot; --namespace game" />
  </Target>
</Project>
