<Project>
  <PropertyGroup>
    <_KarpikSdkTaskAssembly>$(MSBuildThisFileDirectory)..\tools\net10.0\Karpik.Engine.Sdk.Tasks.dll</_KarpikSdkTaskAssembly>
  </PropertyGroup>

  <UsingTask TaskName="Karpik.Engine.Sdk.Tasks.ValidateKarpikProjectReferencesTask"
             AssemblyFile="$(_KarpikSdkTaskAssembly)" />
  <UsingTask TaskName="Karpik.Engine.Sdk.Tasks.BuildKarpikRuntimeBundleTask"
             AssemblyFile="$(_KarpikSdkTaskAssembly)" />

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Target Name="ValidateKarpikProjectReferencesBeforeRestore"
          BeforeTargets="_GenerateRestoreProjectPathWalk"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ValidateKarpikProjectReferencesTask ProjectPath="$(MSBuildProjectFullPath)"
                                         ProjectReferences="@(ProjectReference->'%(FullPath)')" />
  </Target>

  <Target Name="BuildKarpikRuntimeBundle"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(KarpikProjectKind)' == 'Runtime' And ('$(KarpikSide)' == 'Client' Or '$(KarpikSide)' == 'Server')">
    <PropertyGroup>
      <KarpikRuntimeBundlePath Condition="'$(KarpikRuntimeBundlePath)' == ''">$([System.IO.Path]::GetFullPath('$(TargetDir)$(KarpikRuntimeBundleDirectoryName)'))</KarpikRuntimeBundlePath>
    </PropertyGroup>
    <ItemGroup>
      <_KarpikBundleAssembly Include="@(ReferenceCopyLocalPaths)"
                             Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' And '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <_KarpikBundleContent Include="$(TargetDir)Content\**\*"
                            TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <BuildKarpikRuntimeBundleTask Side="$(KarpikSide)"
                                  PrimaryAssembly="$(TargetPath)"
                                  BundlePath="$(KarpikRuntimeBundlePath)"
                                  Assemblies="@(_KarpikBundleAssembly)"
                                  Content="@(_KarpikBundleContent)" />
  </Target>

  <Target Name="ValidateKarpikProjectReferencesBeforeBuild"
          BeforeTargets="AssignProjectConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ValidateKarpikProjectReferencesTask ProjectPath="$(MSBuildProjectFullPath)"
                                         ProjectReferences="@(ProjectReference->'%(FullPath)')" />
  </Target>
</Project>
