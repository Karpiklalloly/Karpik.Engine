<Project Sdk="Microsoft.NET.Sdk">

    <!-- Описывает NuGet-пакет SDK и пути к артефактам, которые будут упакованы. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <PackageId>Karpik.Engine.Sdk</PackageId>
        <PackageVersion Condition="'$(PackageVersion)' == ''">0.6.0-local</PackageVersion>
        <Authors>KarpikEngine</Authors>
        <Description>MSBuild SDK for validated external KarpikEngine game projects.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <KarpikSdkTasksOutputPath Condition="'$(KarpikSdkTasksOutputPath)' == ''">..\Karpik.Engine.Sdk.Tasks\bin\$(Configuration)\net10.0\</KarpikSdkTasksOutputPath>
        <KarpikCoreCodegenOutputPath Condition="'$(KarpikCoreCodegenOutputPath)' == ''">..\Karpik.Engine.Core.Generator\Karpik.Engine.Core.Codegen\bin\$(Configuration)\netstandard2.0\</KarpikCoreCodegenOutputPath>
        <KarpikNetworkCodegenOutputPath Condition="'$(KarpikNetworkCodegenOutputPath)' == ''">..\Network.Codegen\Network.Codegen\bin\$(Configuration)\netstandard2.0\</KarpikNetworkCodegenOutputPath>
        <KarpikContentToolOutputPath Condition="'$(KarpikContentToolOutputPath)' == ''">..\Karpik.Content.Tool\bin\$(Configuration)\net10.0\</KarpikContentToolOutputPath>
        <KarpikContentCodegenOutputPath Condition="'$(KarpikContentCodegenOutputPath)' == ''">..\Karpik.Content.Codegen\bin\$(Configuration)\netstandard2.0\</KarpikContentCodegenOutputPath>
    </PropertyGroup>

    <!-- Собирает DLL MSBuild-задач до упаковки SDK, не добавляя её как runtime-зависимость. -->
    <ItemGroup>
        <ProjectReference Include="..\Karpik.Engine.Sdk.Tasks\Karpik.Engine.Sdk.Tasks.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <ProjectReference Include="..\Karpik.Content.Tool\Karpik.Content.Tool.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <ProjectReference Include="..\Karpik.Content.Codegen\Karpik.Content.Codegen.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <!-- Включает targets, шаблон и готовые DLL в layout NuGet-пакета SDK. -->
    <ItemGroup>
        <None Include="Sdk\Sdk.props" Pack="true" PackagePath="Sdk/" />
        <None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk/" />
        <None Include="Sdk\Solution.targets" Pack="true" PackagePath="Sdk/" />
        <None Include="Templates\Directory.Solution.targets" Pack="true" PackagePath="templates/" />
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="$(KarpikSdkTasksOutputPath)Karpik.Engine.Sdk.Tasks.dll"
              Pack="true"
              PackagePath="tools/net10.0/" />
        <None Include="$(KarpikSdkTasksOutputPath)Karpik.Engine.ProjectModel.dll"
              Pack="true"
              PackagePath="tools/net10.0/" />
        <None Include="$(KarpikSdkTasksOutputPath)Karpik.Engine.Tooling.dll"
              Pack="true"
              PackagePath="tools/net10.0/" />
        <None Include="$(KarpikCoreCodegenOutputPath)Karpik.Engine.Core.Codegen.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/" />
        <None Include="$(KarpikNetworkCodegenOutputPath)Network.Codegen.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>

    <!-- Исключает внешние генераторы из неявного графа и добавляет нужный analyzer явно. -->
    <ItemGroup>
        <ProjectReference Remove="$(KarpikRepositoryRoot)Network.Codegen\Network.Codegen\Network.Codegen.csproj;$(KarpikRepositoryRoot)StatAndAbilities.Codegen\StatAndAbilities.Codegen\StatAndAbilities.Codegen.csproj" />
        <ProjectReference Include="..\Network.Codegen\Network.Codegen\Network.Codegen.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <Target Name="_KarpikPackageContentPayload" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <None Include="$(KarpikContentToolOutputPath)**\*"
                  Pack="true"
                  PackagePath="tools/net10.0/content/" />
            <None Include="$(KarpikContentCodegenOutputPath)**\*"
                  Pack="true"
                  PackagePath="analyzers/dotnet/cs/" />
        </ItemGroup>
    </Target>

</Project>
